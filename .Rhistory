simulate_weak <- function(
n0 = 45,
n1 = 15,
runs = 500
) {
# Construct science table
y0 <- rnorm(n0 + n1, sd = 0.5)
y1 <- rnorm(n0 + n1, sd = 2)
y0 <- y0 - mean(y0)
y1 <- y1 - mean(y1)
groups <- c(rep(0, n0), rep(1, n1))
# 500 different randomisations for this science table
p_HoS <- numeric(runs)
p_HoW <- numeric(runs)
for (run in seq_len(runs)) {
group0 <- sample(seq_len(n0 + n1), n0)
group1 <- setdiff(seq_len(n0 + n1), group0)
y <- c(y0[group0], y1[group1])
p_HoS[[run]] <- randomisation_test(y, groups,
studentised_mean_diff, plot = FALSE, M = 9999)
p_HoW[[run]] <- neyman_test(y, groups)
}
c(
"sig_S" = mean(p_HoS <= 0.05),
"sig_W" = mean(p_HoW <= 0.05)
)
}
simulate_weak(runs = 20)
