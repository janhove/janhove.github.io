p_3 <- no_interaction[[3]]$coefficients[2, 4]
p_value <- min(c(p_1, p_2, p_3))
if (check_interaction) {
interaction <- summary(
lm(cbind(outcome1, outcome2, average) ~ sex*group,
data = df[1:(2 * n), ])
)
