simulate_weak <- function(
n0 = 80,
n1 = 20,
runs = 500
) {
# Generate science table under weak H0
x <- runif(n0 + n1)
y0 <- rnorm(n0 + n1, mean = -x^3, sd = 0.5)
y1 <- rnorm(n0 + n1, mean = x^3, sd = 1)
y0 <- y0 - mean(y0)
y1 <- y1 - mean(y1)
# 500 reassignments
p_HoW <- numeric(runs)
p_HoS <- numeric(runs)
for (run in seq_len(runs)) {
group0 <- sample(seq_len(n0 + n1), n0)
group1 <- setdiff(seq_len(n0 + n1), group0)
}
}
# Generate science table under weak H0
