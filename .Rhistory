simulate_weak <- function(
n0 = 45,
n1 = 15,
runs = 500
) {
# Construct science table
x <- runif(n0 + n1, -1, 1)
y0 <- rnorm(n0 + 1, -x^3, sd = 0.5)
y1 <- rnorm(n0 + n1, x^3, sd = 1)
groups <- c(rep(0, n0), rep(1, n1))
# 500 different randomisations for this science table
p_HoS <- numeric(runs)
p_HoW <- numeric(runs)
for (run in seq_len(runs)) {
group0 <- sample(seq_len(n0 + n1), n0)
group1 <- setdiff(seq(len(n0 + n1)), group0)
y <- c(y0[group0], y1[group1])
p_HoS <- randomisation_test(y, groups, plot = FALSE, M = 9999)
p_HoW <- neyman_test(y, groups)
}
list(p_HoS, p_HoW)
}
simulate_weak <- function(
n0 = 45,
n1 = 15,
runs = 500
) {
# Construct science table
x <- runif(n0 + n1, -1, 1)
y0 <- rnorm(n0 + 1, -x^3, sd = 0.5)
y1 <- rnorm(n0 + n1, x^3, sd = 1)
groups <- c(rep(0, n0), rep(1, n1))
# 500 different randomisations for this science table
p_HoS <- numeric(runs)
p_HoW <- numeric(runs)
for (run in seq_len(runs)) {
group0 <- sample(seq_len(n0 + n1), n0)
group1 <- setdiff(seq(len(n0 + n1)), group0)
y <- c(y0[group0], y1[group1])
p_HoS <- randomisation_test(y, groups, plot = FALSE, M = 9999)
p_HoW <- neyman_test(y, groups)
}
c(
"sig_S" = mean(p_HoS <= 0.05),
"sig_W" = mean(p_HoW <= 0.05)
)
}
simulate_weak()
