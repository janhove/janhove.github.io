simulate_weak <- function(
n0 = 80,
n1 = 20,
runs = 500
) {
# Generate science table under weak H0
x <- runif(n0 + n1)
y0 <- rnorm(n0 + n1, mean = -x^3, sd = 0.5)
y1 <- rnorm(n0 + n1, mean = x^3, sd = 1)
y0 <- y0 - mean(y0)
y1 <- y1 - mean(y1)
# 500 reassignments
p_HoW <- numeric(runs)
p_HoS <- numeric(runs)
for (run in seq_len(runs)) {
group0 <- sample(seq_len(n0 + n1), n0)
group1 <- setdiff(seq_len(n0 + n1), group0)
outcome <- c(y0[group0], y1[group1])
groups <- c(rep(0, n0), rep(1, n1))
p_HoW[[run]] <- neyman_test(outcome, groups)
p_HoS[[run]] <- randomisation_test(outcome, groups, fun = studentised_mean_diff)
}
list(
p_HoW,
p_HoS
)
}
simulate_weak(runs = 20)
simulate_weak <- function(
n0 = 80,
n1 = 20,
runs = 500
) {
# Generate science table under weak H0
x <- runif(n0 + n1)
y0 <- rnorm(n0 + n1, mean = -x^3, sd = 0.5)
y1 <- rnorm(n0 + n1, mean = x^3, sd = 1)
y0 <- y0 - mean(y0)
y1 <- y1 - mean(y1)
# 500 reassignments
p_HoW <- numeric(runs)
p_HoS <- numeric(runs)
for (run in seq_len(runs)) {
group0 <- sample(seq_len(n0 + n1), n0)
group1 <- setdiff(seq_len(n0 + n1), group0)
outcome <- c(y0[group0], y1[group1])
groups <- c(rep(0, n0), rep(1, n1))
p_HoW[[run]] <- neyman_test(outcome, groups)
p_HoS[[run]] <- randomisation_test(outcome, groups,
fun = studentised_mean_diff, plot = FALSE)
}
list(
,
p_HoS
)
}
