repeat {
if (p_value <= 0.05) break
if (n > max_n) break
no_interaction <- summary(
lm(cbind(outcome1, outcome2, average) ~ group,
data = df[1:(2 * n), ])
)
p_1 <- no_interaction[[1]]$coefficients[2, 4]
